# Display on top of DAGU_MINIMAL + dagu-usb: hand MDSS to DRM_MSM instead of
# borrowing ABL's continuous splash.
#
# The splash console cannot survive apps_smmu: arm_smmu_device_reset() disables
# every context bank and rewrites every S2CR, and QHEE hands the display stream
# over as TRANS rather than BYPASS, so qcom_smmu_cfg_probe() pins nothing
# ("preserved 0 boot mappings"). MDP's scanout of cont_splash_region dies 26ms
# after fbcon takes over — black panel, backlight still on from ABL. Neither
# arm-smmu.disable_bypass=0 nor the Kconfig default helps, because MDP is
# issuing IOVAs that stop resolving once the boot context banks are gone.
#
# MDSS has its own "iommus = <&apps_smmu 0x820 0x402>", so once DRM_MSM drives
# it the SMMU stops being a conflict and the panel becomes a real console.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_XIAOMI_DAGU_L81A=y
CONFIG_DRM_FBDEV_EMULATION=y

# dispcc owns MDSS_GDSC and the AHB/MDP clocks. tlmm owns panel reset (GPIO 75),
# TP reset (100) and the LCD bias enables (130/131) — without PINCTRL_SM8250
# the bl_vddpos/bl_vddneg regulators just defer forever.
CONFIG_SM_DISPCC_8250=y
CONFIG_PINCTRL_SM8250=y
# DSI ctrl lists refgen-supply; defconfig builds this as =m and ramdisk
# never loads it, so both dsi@ae94000/ae96000 sit in deferred probe forever.
CONFIG_REGULATOR_QCOM_REFGEN=y

# simplefb and DRM fbdev cannot both own fbcon, and the splash path is dead.
# Keep TER16x32 from dagu-bringup.fragment: 8x16 is 160 rows on this panel.
# CONFIG_FB_SIMPLE is not set

# No INTERCONNECT_QCOM_SM8250 here, same reason as dagu-usb.fragment: the BCM
# voter's rpmh_write_batch() times out on this QHEE chain. sm8250-xiaomi-dagu.dts
# deletes mdss's "interconnects" so of_icc_get() returns NULL and msm_mdss skips
# the vote — ABL already trained MASTER_MDP_PORT0/1 to run the splash over it.
