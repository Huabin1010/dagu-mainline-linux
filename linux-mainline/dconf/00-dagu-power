[org/gnome/settings-daemon/plugins/power]
# gsd-media-keys takes a BLOCK inhibitor on handle-power-key.
# logind HandlePowerKey never runs. This key is the product path.
power-button-action='suspend'
lid-close-ac-action='suspend'
lid-close-battery-action='suspend'
# After s2idle, mutter re-probes DSI/Writeback and gsd-power
# pretends an external monitor appeared. Still sleep on cover.
lid-close-suspend-with-external-monitor=true
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
idle-dim=false
ambient-enabled=false

[org/gnome/desktop/screensaver]
lock-enabled=false
ubuntu-lock-on-suspend=false
