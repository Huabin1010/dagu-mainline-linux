/*
 * Xiaomi Pad 5 Pro 12.4 (dagu) — P0 ramdisk + RNDIS.
 *
 * Include elish-common for PMIC / RPMH / USB2 PHY supplies. Override
 * board-id, RAM, and turn off everything that is not needed to reach
 * PID1 and register a HS UDC.
 *
 * USB: force gadget (no Type-C role-switch). ABL already trained the
 * PHY; waiting on pm8150b_typec left DWC3 in otg with no UDC.
 * Full board tree: sm8250-xiaomi-dagu-full.dts.
 */

/dts-v1/;

#include "sm8250-xiaomi-elish-common.dtsi"
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Xiaomi Pad 5 Pro 12.4";
	compatible = "xiaomi,dagu", "qcom,sm8250";

	qcom,board-id = <0x33 0>;

	/delete-node/ memory@80000000;
	memory {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x3bb00000>,
		      <0x0 0xc0000000 0x1 0xc0000000>;
	};

	chosen {
		stdout-path = "tty0";
	};
};

/delete-node/ &framebuffer;

&{/soc@0/watchdog@17c10000} {
	timeout-sec = <40>;
};

/* HS gadget only. Do not wait for TCPM / role-switch. */
&usb_1 {
	qcom,select-utmi-as-pipe-clk;
	status = "okay";
};

&usb_1_hsphy {
	status = "okay";
};

&usb_1_qmpphy {
	status = "disabled";
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	/delete-property/ usb-role-switch;
	/delete-property/ iommus;
};

&pm8150b_typec {
	status = "disabled";
};

&usb_1_dwc3_hs_out {
	/delete-property/ remote-endpoint;
};

/* Logo / MDSS / GPU / storage / Wi-Fi / DSP: off until RNDIS lives. */
&mdss { status = "disabled"; };
&mdss_dsi0 { status = "disabled"; };
&mdss_dsi1 { status = "disabled"; };
&mdss_dsi0_phy { status = "disabled"; };
&mdss_dsi1_phy { status = "disabled"; };
&display_panel { status = "disabled"; };
&backlight { status = "disabled"; };
&gpu { status = "disabled"; };
&gmu { status = "disabled"; };
&apps_smmu { status = "disabled"; };
&ufs_mem_hc { status = "disabled"; };
&ufs_mem_phy { status = "disabled"; };
&pcie0 { status = "disabled"; };
&pcie0_phy { status = "disabled"; };
&pcie1 { status = "disabled"; };
&pcie2 { status = "disabled"; };

&adsp {
	firmware-name = "qcom/sm8250/xiaomi/dagu/adsp.mbn";
	status = "disabled";
};

&cdsp { status = "disabled"; };

&slpi {
	firmware-name = "qcom/sm8250/xiaomi/dagu/slpi.mbn";
	status = "disabled";
};

&venus {
	firmware-name = "qcom/sm8250/xiaomi/dagu/venus.mbn";
	status = "disabled";
};

&camcc { status = "disabled"; };
&cci0 { status = "disabled"; };
&cci1 { status = "disabled"; };
&camss { status = "disabled"; };
&sound { status = "disabled"; };
&uart6 { status = "disabled"; };
&gpio_keys { status = "disabled"; };

&i2c0 { status = "disabled"; };
&i2c11 { status = "disabled"; };
&i2c13 { status = "disabled"; };
&gpi_dma0 { status = "disabled"; };
&gpi_dma1 { status = "disabled"; };
&gpi_dma2 { status = "disabled"; };
&qupv3_id_0 { status = "disabled"; };
&qupv3_id_1 { status = "disabled"; };
&qupv3_id_2 { status = "disabled"; };

&{/qca6390-pmu} {
	status = "disabled";
};
