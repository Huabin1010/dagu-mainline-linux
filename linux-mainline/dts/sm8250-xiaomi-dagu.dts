// SPDX-License-Identifier: BSD-3-Clause
/*
 * Xiaomi Pad 5 Pro 12.4 (dagu) — P0 ramdisk + RNDIS.
 *
 * Include elish-common for PMIC / RPMH / USB2 PHY supplies. Override
 * board-id, RAM, and turn off everything that is not needed to reach
 * PID1 and register a HS UDC.
 *
 * USB: force gadget (no Type-C role-switch). ABL already trained the
 * PHY; waiting on pm8150b_typec left DWC3 in otg with no UDC.
 * Full board tree: sm8250-xiaomi-dagu-full.dts.
 */

/dts-v1/;

#include "sm8250-xiaomi-elish-common.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>

/ {
	model = "Xiaomi Pad 5 Pro 12.4";
	compatible = "xiaomi,dagu", "qcom,sm8250";

	qcom,board-id = <0x33 0>;

	/delete-node/ memory@80000000;
	/delete-node/ reserved-memory;

	memory {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x3bb00000>,
		      <0x0 0xc0000000 0x1 0xc0000000>;
	};

	chosen {
		stdout-path = "tty0";
	};

	/*
	 * Replace sm8250.dtsi reserved-memory (wrong xbl_aop/adsp/slpi offsets on
	 * dagu) with stock fdt from dumps/dagu-20260826-linux-bringup/dt-extract/.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

#include "dagu-reserved-memory-stock.dtsi"

		ramoops@b0000000 {
			compatible = "ramoops";
			reg = <0x0 0xb0000000 0x0 0x400000>;
			record-size = <0x100000>;
			console-size = <0x100000>;
			ftrace-size = <0x100000>;
			pmsg-size = <0x100000>;
			no-map;
		};
	};

	/*
	 * CAF &qupv3_se4_spi @ 0x990000, pins gpio8–11 function qup4.
	 * Mainline GENI SPI (firmware load / geni_se_init) writes QUP
	 * registers this QHEE rejects and the board watchdogs to fastboot.
	 * Bit-bang the same pads: protocol/IRQ/coords stay CAF.
	 *
	 * QUP v3 SPI lanes (Qualcomm): L0=MISO L1=MOSI L2=SCLK L3=CS.
	 * gpio8–11 are QUP0 SE4 L0–L3, so MOSI is gpio9, not pingroup order.
	 */
	himax_spi: spi {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&himax_spi_gpio_default>;
		miso-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
		sck-gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;
		num-chipselects = <1>;

		himax_ts: touchscreen@0 {
			compatible = "himax,hx83121-dagu", "himax,hxcommon";
			reg = <0>;
			spi-max-frequency = <1000000>;
			/* CAF probe forces SPI_MODE_3 (CPOL|CPHA), not DT CPHA. */
			spi-cpol;
			spi-cpha;
			pinctrl-names = "default";
			pinctrl-0 = <&himax_irq_default>;
			interrupt-parent = <&tlmm>;
			interrupts = <39 IRQ_TYPE_EDGE_FALLING>;
			touchscreen-size-x = <1600>;
			touchscreen-size-y = <2560>;
			himax,display-coords = <0 1600 0 2560>;
			/* GPIO100 is panel tp-reset; do not bind it here. */
		};
	};
};

/*
 * CAF dagu: GPIO 130/131 = LCD bias ENP/ENN (±5.5 V), not WLED HWEN.
 * elish-common names them bl_vddpos/bl_vddneg with regulator-boot-on.
 */
&bl_vddpos_5p5 {
	pinctrl-names = "default";
	pinctrl-0 = <&display_enp_default>;
	regulator-always-on;
};

&bl_vddneg_5p5 {
	pinctrl-names = "default";
	pinctrl-0 = <&display_enn_default>;
	regulator-always-on;
};

&tlmm {
	display_enp_default: display-enp-default-state {
		pins = "gpio130";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	display_enn_default: display-enn-default-state {
		pins = "gpio131";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	/* CAF qcom,platform-tp-reset-gpio = GPIO 100, driven high in power_on. */
	tp_reset_default: tp-reset-default-state {
		pins = "gpio100";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	/*
	 * CAF himax,irq-gpio = GPIO 39 (0x2008 = input / pull-up).
	 * Falling edge; in-cell HX83121 shares the panel, not a second reset.
	 */
	himax_irq_default: himax-irq-default-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		input-enable;
	};

	/*
	 * QUP0 SE4 SPI pads as GPIO. GENI MMIO hangs this QHEE, so Himax
	 * rides spi-gpio on the same CAF pins (MOSI/MISO/CLK/CS).
	 */
	himax_spi_gpio_default: himax-spi-gpio-default-state {
		pins = "gpio8", "gpio9", "gpio10", "gpio11";
		function = "gpio";
		drive-strength = <6>;
		bias-disable;
	};
};

/*
 * simplefb on ABL's splash buffer is a dead end now that apps_smmu is back for
 * USB: arm_smmu_device_reset() disables every boot context bank, QHEE handed
 * the display stream over as TRANS ("preserved 0 boot mappings"), and MDP's
 * scanout stops resolving 26ms after fbcon takes over — black panel, backlight
 * still on. DRM_MSM drives MDSS through its own iommus instead, and DRM fbdev
 * gets fbcon. cont_splash_region keeps no-map so ABL can scan out until then.
 */
/delete-node/ &framebuffer;

/*
 * qcom,kpss-wdt caps BITE_TIME at 20 bits, so 0xfffff / 32764 Hz = 32 s is
 * the ceiling; 40 was rejected as "out of range" and silently fell back.
 */
&{/soc@0/watchdog@17c10000} {
	timeout-sec = <30>;
};

/*
 * P0 USB: PID1 proven (PID1-ping bounced to fastboot ~6s).
 * HS-only peripheral g_serial (0525:a4a7 / ttyGS0), no role-switch,
 * Matches sm8250-xiaomi-dagu-full.dts recipe.
 *
 * icc paths deleted: the BCM voter's rpmh_write_batch() never gets its AMC
 * completion on this QHEE chain (-ETIMEDOUT), and dwc3_qcom_probe() tears
 * the core back down on that error, so no UDC ever appears. of_icc_get()
 * returns NULL when "interconnects" is absent, so the driver just skips the
 * vote — ABL already trained this NoC path to run fastboot over it.
 */
&usb_1 {
	qcom,select-utmi-as-pipe-clk;
	/delete-property/ interconnects;
	/delete-property/ interconnect-names;
	status = "okay";
};

&usb_1_hsphy {
	status = "okay";
};

&usb_1_qmpphy {
	status = "disabled";
};

&pm8150b_typec {
	status = "disabled";
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	/delete-property/ usb-role-switch;
};

/* P0 bisect: off until PID1 proven — I2C wait can block probe queue. */
&i2c17 {
	status = "disabled";
};

/* L81A dual-DPHY 4-lane (not elish NT36523 CPHY — that SErrors). */
&apps_rsc {
	regulators-0 {
		vreg_l7a_1p83: ldo7 {
			regulator-name = "vreg_l7a_1p83";
			regulator-min-microvolt = <1832000>;
			regulator-max-microvolt = <1832000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	/*
	 * dagu is not stuffed with pm8009 (elish's camera PMIC): RPMh has no
	 * "smpf1" resource and SPMI reads to usid 0xa/0xb all time out. Cut the
	 * rpmh-regulator node here and both spmi devices below.
	 */
	regulators-2 {
		status = "disabled";
	};
};

&{/soc@0/spmi@c440000/pmic@a} {
	status = "disabled";
};

&{/soc@0/spmi@c440000/pmic@b} {
	status = "disabled";
};

/* &gpu/&gmu need SM_GPUCC_8250; zap is dump a650_zap.mbn. */
&adreno_smmu {
	status = "okay";
};

/*
 * icc paths deleted for the same reason as usb_1: msm_mdss asks for mdp0-mem /
 * mdp1-mem, the BCM voter turns that into rpmh_write_batch(), and it never gets
 * its AMC completion here. ABL already trained MASTER_MDP_PORT0/1 for the
 * splash, so skipping the vote is fine.
 */
&mdss {
	/delete-property/ interconnects;
	/delete-property/ interconnect-names;
	status = "okay";
};
/*
 * apps_smmu back on for USB. With it off, QHEE's leftover stream config
 * stays in charge of DWC3's DMA: the gadget pulls up (host logs a HS
 * device) but never answers EP0 — "Device not responding to setup
 * address", error -71 — and the unread event buffer storms the core IRQ
 * until the KPSS WDT resets us. GPI-DMA / QUP stay off (Route-2 bisect).
 */

/*
 * elish-common sets qcom,sync-dual-dsi. Mainline then skips DSI_0 TX and
 * only broadcasts from DSI_1. Dual write already talks to both hosts.
 */
&mdss_dsi0 {
	/delete-property/ qcom,sync-dual-dsi;
	status = "okay";
};

&mdss_dsi1 {
	/delete-property/ qcom,sync-dual-dsi;
	status = "okay";
};

&mdss_dsi0_phy {
	phy-type = <PHY_TYPE_DPHY>;
	status = "okay";
};

&mdss_dsi1_phy {
	phy-type = <PHY_TYPE_DPHY>;
	status = "okay";
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
};

&mdss_dsi1_out {
	data-lanes = <0 1 2 3>;
};

&display_panel {
	compatible = "xiaomi,dagu-l81a";
	pinctrl-names = "default";
	pinctrl-0 = <&tp_reset_default>;
	vddio-supply = <&vreg_l7a_1p83>;
	enp-supply = <&bl_vddpos_5p5>;
	enn-supply = <&bl_vddneg_5p5>;
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
	tp-reset-gpios = <&tlmm 100 GPIO_ACTIVE_HIGH>;
	/*
	 * backlight stays deleted: ABL already lit the WLED, and a "backlight"
	 * phandle to the KTZ8866 on the still-disabled i2c9 would make
	 * drm_panel_of_backlight() EPROBE_DEFER forever.
	 */
	/delete-property/ backlight;
	/delete-property/ backlight-aux;
	/delete-property/ rotation;
	status = "okay";
};

/* P0 bisect: KTZ8866 I2C can hang probe if bias rails are not ready. */
&backlight {
	status = "disabled";
};

&i2c9 {
	status = "disabled";
};

&gpu {
	status = "okay";
};

&gmu {
	status = "okay";
};

/*
 * CPU interconnects pull gem_noc/epss_l3. INTERCONNECT_QCOM_SM8250 is off
 * (BCM voter hangs this QHEE), and of_icc_get() then EPROBE_DEFER inside
 * _allocate_opp_table(), so even LUT-only dev_pm_opp_add() cannot create a
 * table. Drop the paths; EPSS still programs frequency in the HW LUT.
 */
&cpu0 { /delete-property/ interconnects; };
&cpu1 { /delete-property/ interconnects; };
&cpu2 { /delete-property/ interconnects; };
&cpu3 { /delete-property/ interconnects; };
&cpu4 { /delete-property/ interconnects; };
&cpu5 { /delete-property/ interconnects; };
&cpu6 { /delete-property/ interconnects; };
&cpu7 { /delete-property/ interconnects; };

&gpu_zap_shader {
	firmware-name = "qcom/sm8250/xiaomi/dagu/a650_zap.mbn";
};

/*
 * elish-common already sets vcc/vccq and status=okay. Drop interconnects so
 * ufshcd's of_icc_get() skips the BCM voter (same QHEE AMC timeout as USB/MDSS).
 * PID1 stays on ramdisk forever without a block device.
 */
&ufs_mem_hc {
	/delete-property/ interconnects;
	/delete-property/ interconnect-names;
	status = "okay";
};
&ufs_mem_phy { status = "okay"; };
&pcie0 { status = "okay"; };
&pcie0_phy { status = "okay"; };
&pcie1 { status = "disabled"; };
&pcie2 { status = "disabled"; };

&pcieport0 {
	wifi@0 {
		/* board.bin = dump bd_l81a.elf; do not use board-2.bin */
		/delete-property/ qcom,calibration-variant;
		local-mac-address = [f0 6c 5d 71 3a 2b];
	};
};

&adsp {
	firmware-name = "qcom/sm8250/xiaomi/dagu/adsp.mbn";
	status = "disabled";
};

&cdsp { status = "disabled"; };

&slpi {
	firmware-name = "qcom/sm8250/xiaomi/dagu/slpi.mbn";
	status = "disabled";
};

&venus {
	firmware-name = "qcom/sm8250/xiaomi/dagu/venus.mbn";
	status = "disabled";
};

&camcc { status = "disabled"; };
&cci0 { status = "disabled"; };
&cci1 { status = "disabled"; };
&camss { status = "disabled"; };
&sound { status = "disabled"; };
&gpio_keys { status = "disabled"; };

&uart6 {
	/delete-property/ interconnects;
	/delete-property/ interconnect-names;
	status = "okay";
	bluetooth {
		firmware-name = "qca/htbtfw20.tlv";
	};
};

&i2c0 { status = "disabled"; };
&i2c11 { status = "disabled"; };
&i2c13 { status = "disabled"; };
&gpi_dma1 { status = "disabled"; };
&gpi_dma2 { status = "disabled"; };
&qupv3_id_1 { status = "disabled"; };
&qupv3_id_2 { status = "disabled"; };

/*
 * GENI QUP0 SE4 stays off: geni_load_se_fw / geni_se_init hang this QHEE.
 * Himax is on the spi-gpio node in / { himax_spi }.
 * Wrapper is on for uart6 (QCA6390 BT, SE6). SERIAL skips QUPFW load.
 */
&gpi_dma0 { status = "disabled"; };
&qupv3_id_0 { status = "okay"; };
&spi4 { status = "disabled"; };

&{/qca6390-pmu} {
	status = "okay";
};

/*
 * Must be last: elish-common ends with &usb_1_dwc3_hs_out → pm8150b_hs_in.
 * With pm8150b_typec disabled, cut both ends of the graph (and SS to qmpphy).
 */
&usb_1_dwc3_hs_out {
	/delete-property/ remote-endpoint;
};

&usb_1_dwc3_ss_out {
	/delete-property/ remote-endpoint;
};

&pm8150b_hs_in {
	/delete-property/ remote-endpoint;
};

&usb_1_qmpphy_usb_ss_in {
	/delete-property/ remote-endpoint;
};
