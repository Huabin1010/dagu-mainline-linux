From: dagu <dagu@localhost>
Date: Sat, 12 Sep 2026 15:10:00 +0800
Subject: [PATCH 2/2] freedreno/a6xx: fix GMEM fb-read base for LINEAR RTs

patch_fb_read_gmem added screen->gmem_base (0x100000 on msm) to the
UCHE TEX_CONST. That is the RB resolve aperture. On a650 the blob
samples GMEM at the bin offset (cbuf 0 for the first color). Fetching
from 0x100000 returned empty or destile garbage, which forced a
sysmem fallback for LINEAR+FD_GMEM_FB_READ.

Use cbuf_base only when the sysmem RT is LINEAR. Keep gmem_base for
tiled RTs. Describe the GMEM tile as TILE6_2 and use a 0 array pitch
for a single layer.

Between paint and fb-read, flush CCU color and invalidate the cache.
Do not invalidate CCU color — that drops LINEAR pixels still in CCU.

---
--- a/src/gallium/drivers/freedreno/a6xx/fd6_gmem.cc
+++ b/src/gallium/drivers/freedreno/a6xx/fd6_gmem.cc
@@ -405,12 +405,22 @@
       uint8_t swiz[4];
       fdl6_format_swiz(psurf->format, false, swiz);
 
+      enum a6xx_tile_mode sys_tile = (enum a6xx_tile_mode)
+            fd_resource_tile_mode(prsc, psurf->level);
+
       /* always TILE6_2 mode in GMEM, which also means no swap: */
       if (CHIP <= A7XX) {
-         uint64_t base = screen->gmem_base + gmem->cbuf_base[buf];
+         /* a650 UCHE samples GMEM at the bin offset (blob TEX_CONST
+          * base=0). msm's gmem_base 0x100000 is the RB aperture;
+          * adding it made fetch read empty/garbage. Tiled sysmem RTs
+          * keep the historical gmem_base add.
+          */
+         uint64_t base = gmem->cbuf_base[buf];
+         if (sys_tile != TILE6_LINEAR)
+            base += screen->gmem_base;
          uint32_t descriptor[FDL6_TEX_CONST_DWORDS] = {
                A6XX_TEX_CONST_0_FMT(fd6_texture_format(
-                     format, (enum a6xx_tile_mode)rsc->layout.tile_mode, false)) |
+                     format, TILE6_2, false)) |
                A6XX_TEX_CONST_0_SAMPLES(fd_msaa_samples(prsc->nr_samples)) |
                A6XX_TEX_CONST_0_SWAP(WZYX) |
                A6XX_TEX_CONST_0_TILE_MODE(TILE6_2) |
@@ -426,7 +436,13 @@
             A6XX_TEX_CONST_2_PITCH(gmem->bin_w * gmem->cbuf_cpp[buf]) |
                A6XX_TEX_CONST_2_TYPE(A6XX_TEX_2D),
 
-            A6XX_TEX_CONST_3_ARRAY_PITCH(rsc->layout.layer_size),
+            /* Keep Turnip's 0-for-1-layer. Tile size is only needed
+             * when array_size > 1.
+             */
+            A6XX_TEX_CONST_3_ARRAY_PITCH(
+               prsc->array_size > 1
+                  ? gmem->bin_w * gmem->bin_h * gmem->cbuf_cpp[buf]
+                  : 0),
             A6XX_TEX_CONST_4_BASE_LO(base),
 
             A6XX_TEX_CONST_5_BASE_HI(base >> 32) |
--- a/src/gallium/drivers/freedreno/a6xx/fd6_emit.cc
+++ b/src/gallium/drivers/freedreno/a6xx/fd6_emit.cc
@@ -554,9 +554,18 @@
    /* Special case, we need to re-emit bindless FS state w/ the
     * fb-read state appended:
     */
-   if ((emit->dirty_groups & BIT(FD6_GROUP_PROG)) && fs->fb_read) {
+   if (fs->fb_read) {
       ctx->batch->gmem_reason |= FD_GMEM_FB_READ;
-      emit->dirty_groups |= BIT(FD6_GROUP_FS_BINDLESS);
+      if (emit->dirty_groups & BIT(FD6_GROUP_PROG))
+         emit->dirty_groups |= BIT(FD6_GROUP_FS_BINDLESS);
+      /* Blob LINEAR input-att, between paint and subpassLoad:
+       *   CP_EVENT_WRITE PC_CCU_FLUSH_COLOR_TS
+       *   CP_EVENT_WRITE CACHE_INVALIDATE
+       * It does not invalidate CCU color. On a650 that drop kills
+       * LINEAR 3D pixels that have not yet landed in the GMEM bin.
+       */
+      ctx->batch->barrier |= FD6_FLUSH_CCU_COLOR | FD6_INVALIDATE_CACHE |
+                             FD6_WAIT_FOR_IDLE;
    }
 
    u_foreach_bit (b, emit->dirty_groups) {
