 #ifndef V4L2_CID_MPEG_VIDEO_H264_HIER_CODING_L0_BR
 #define V4L2_CID_MPEG_VIDEO_H264_HIER_CODING_L0_BR (V4L2_CID_CODEC_BASE + 391)
 #endif
@@ -647,6 +649,19 @@
         break;
     }
