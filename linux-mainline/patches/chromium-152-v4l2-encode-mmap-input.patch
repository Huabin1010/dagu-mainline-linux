+#if !BUILDFLAG(IS_CHROMEOS)
+  // dagu: never hand client memory to Venus as USERPTR on Linux. The
+  // client frame is laid out for its own coded size (1920x1080 NV12 puts
+  // UV at row 1080) while Venus reads the S_FMT layout (UV at row 1088,
+  // sizeimage bytes). USERPTR then pins whatever follows the frame and
+  // encodes the wrong chroma, and MSI frames mapped from a GEM BO are not
+  // page-backed; Iris2 faulted in the SMMU and the firmware died. Copy
+  // each frame into driver-allocated MMAP buffers instead, as ffmpeg
+  // h264_v4l2m2m does.
+  if (input_memory_type_ == V4L2_MEMORY_USERPTR) {
+    input_memory_type_ = V4L2_MEMORY_MMAP;
+  }
+#endif
   return true;
