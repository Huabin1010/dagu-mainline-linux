+bool V4L2VideoEncodeAccelerator::CopyFrameToMMapBuffer(
+    const VideoFrame& frame,
+    V4L2WritableBufferRef& input_buf,
+    size_t num_v4l2_planes) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(encoder_sequence_checker_);
+  if (!frame.HasDirectCpuAccess() ||
+      device_input_layout_->format() != PIXEL_FORMAT_NV12 ||
+      device_input_layout_->planes().size() != 2 ||
+      (num_v4l2_planes != 1 && num_v4l2_planes != 2)) {
+    return false;
+  }
+  const gfx::Size visible = frame.visible_rect().size();
+  const gfx::Size coded = device_input_layout_->coded_size();
+  if (visible.IsEmpty() || visible.width() > coded.width() ||
+      visible.height() > coded.height()) {
+    return false;
+  }
+  // Destination is the S_FMT layout: both color planes inside V4L2 plane 0
+  // for NV12, one per V4L2 plane for NV12M.
+  uint8_t* dst[2];
+  int dst_stride[2];
+  for (size_t i = 0; i < 2; ++i) {
+    const size_t buf_plane = num_v4l2_planes == 1 ? 0 : i;
+    const auto& layout = device_input_layout_->planes()[i];
+    const size_t offset = num_v4l2_planes == 1 ? layout.offset : 0;
+    const size_t rows = i == 0 ? coded.height() : (coded.height() + 1) / 2;
+    base::CheckedNumeric<size_t> end = layout.stride;
+    end *= rows;
+    end += offset;
+    auto* base = static_cast<uint8_t*>(input_buf.GetPlaneMapping(buf_plane));
+    if (!base || !end.IsValid() ||
+        end.ValueOrDie() > input_buf.GetPlaneSize(buf_plane) ||
+        layout.stride < static_cast<size_t>(visible.width()) ||
+        layout.stride > static_cast<size_t>(std::numeric_limits<int>::max())) {
+      return false;
+    }
+    dst[i] = UNSAFE_TODO(base + offset);
+    dst_stride[i] = static_cast<int>(layout.stride);
+  }
+  const int w = visible.width();
+  const int h = visible.height();
+  if (frame.format() == PIXEL_FORMAT_NV12) {
+    libyuv::CopyPlane(frame.visible_data(VideoFrame::Plane::kY),
+                      base::checked_cast<int>(frame.stride(VideoFrame::Plane::kY)), dst[0],
+                      dst_stride[0], w, h);
+    libyuv::CopyPlane(frame.visible_data(VideoFrame::Plane::kUV),
+                      base::checked_cast<int>(frame.stride(VideoFrame::Plane::kUV)), dst[1],
+                      dst_stride[1], (w + 1) & ~1, (h + 1) / 2);
+    return true;
+  }
+  if (frame.format() == PIXEL_FORMAT_I420) {
+    return libyuv::I420ToNV12(
+               frame.visible_data(VideoFrame::Plane::kY),
+               base::checked_cast<int>(frame.stride(VideoFrame::Plane::kY)),
+               frame.visible_data(VideoFrame::Plane::kU),
+               base::checked_cast<int>(frame.stride(VideoFrame::Plane::kU)),
+               frame.visible_data(VideoFrame::Plane::kV),
+               base::checked_cast<int>(frame.stride(VideoFrame::Plane::kV)), dst[0], dst_stride[0],
+               dst[1], dst_stride[1], w, h) == 0;
+  }
+  return false;
+}
