From: dagu adaptation
Subject: freedreno: sysmem when color RT is LINEAR

a650 BLIT_EVENT_STORE writes macrotile into TILE6_LINEAR. Large solids
still look like UI; glyphs are high-frequency so they become 1-bit snow,
and a scroll restores more wrong tiles.

Do not use the BIN_RESOLVE CP_BLIT destile (random iova, whole-desktop
snow). Do not force unused-depth sysmem of TILE6_3 (CCU hang 00800005).

Bypass GMEM only when the color RT tile mode is linear. Tiled WebGL
stays GMEM. DAGU_LINEAR_SYSMEM=0 disables the hook.

--- a/src/gallium/drivers/freedreno/freedreno_gmem.c
+++ b/src/gallium/drivers/freedreno/freedreno_gmem.c
@@ -6,6 +6,8 @@
  *    Rob Clark <robclark@freedesktop.org>
  */
 
+#include <stdlib.h>
+
 #include "pipe/p_state.h"
 #include "util/format/u_format.h"
 #include "util/hash_table.h"
@@ -753,6 +755,35 @@
       sysmem = true;
    }
 
+   /* dagu a650: BLIT_EVENT_STORE of TILE6_LINEAR writes macrotile. Large
+    * solids still look like UI; glyphs are high-frequency so they read as
+    * 1-bit snow, and a scroll restores more wrong tiles. Per-tile CP_BLIT
+    * destile in RM6_BIN_RESOLVE writes a random iova — keep that off.
+    * unused-depth sysmem of TILE6_3 WebGL CCU-hangs (irq 00800005). Only
+    * bypass when the color RT itself is linear. DAGU_LINEAR_SYSMEM=0
+    * disables the hook for A/B.
+    */
+   if (!sysmem && ctx->emit_sysmem_prep) {
+      static int linear_sysmem = -1;
+      if (linear_sysmem < 0) {
+         const char *e = getenv("DAGU_LINEAR_SYSMEM");
+         linear_sysmem = (e && atoi(e) != 0);
+      }
+      if (linear_sysmem) {
+         for (unsigned i = 0; i < pfb->nr_cbufs; i++) {
+            struct pipe_surface *psurf = &pfb->cbufs[i];
+            if (!psurf->texture)
+               continue;
+            if (fd_resource_tile_mode(psurf->texture, psurf->level) == 0) {
+               sysmem = true;
+               break;
+            }
+         }
+      }
+   }
+
    fd_reset_wfi(batch);
 
    ctx->stats.batch_total++;
