+static int is_v4l2_loopback(const struct spa_v4l2_device *dev)
+{
+	return strncmp((const char *)dev->cap.driver, "v4l2 loopback", 13) == 0;
+}
+
+static int is_dagu_rear_loopback(const struct spa_v4l2_device *dev)
+{
+	return is_v4l2_loopback(dev) &&
+	       strcmp(dev->path, "/dev/video21") == 0;
+}
+
+/* GNOME Snapshot gtk4paintablesink H-mirrors every camera. Meeting mmap
+ * does not. Rear: YUYV pair reverse so GNOME matches Meeting. Front:
+ * identity copy so that gtk H-mirror is the selfie preview. */
+static void loopback_copy_hflip_yuyv(uint8_t *dst, const uint8_t *src,
+				     uint32_t width, uint32_t height,
+				     uint32_t stride, uint32_t nbytes)
+{
+	uint32_t y, x;
+
+	if (!dst || !src || width < 2 || (width & 1u) ||
+	    stride < width * 2 || nbytes < stride) {
+		if (dst && src && nbytes)
+			memcpy(dst, src, nbytes);
+		return;
+	}
+	if (height > nbytes / stride)
+		height = nbytes / stride;
+	for (y = 0; y < height; y++) {
+		const uint8_t *s = src + (size_t)y * stride;
+		uint8_t *d = dst + (size_t)y * stride;
+		for (x = 0; x < width; x += 2) {
+			const uint8_t *sp = s + (width - 2 - x) * 2;
+			uint8_t *dp = d + x * 2;
+			dp[0] = sp[2];
+			dp[1] = sp[1];
+			dp[2] = sp[0];
+			dp[3] = sp[3];
+		}
+		if (stride > width * 2)
+			memcpy(d + width * 2, s + width * 2, stride - width * 2);
+	}
+}
