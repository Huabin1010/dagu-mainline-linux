# Desktop cameras: v4l2loopback. Session user is in group video.
# exclusive_caps=1 registers OUTPUT until stamp; v4l_id then writes
# ID_V4L_CAPABILITIES=:video_output: and Chrome skips the node.
SUBSYSTEM=="video4linux", ATTR{name}=="dagu-front", GROUP="video", MODE="0660", ENV{ID_V4L_CAPABILITIES}=":capture:"
SUBSYSTEM=="video4linux", ATTR{name}=="dagu-rear", GROUP="video", MODE="0660", ENV{ID_V4L_CAPABILITIES}=":capture:"
# CAMSS RDI is 12MP Bayer. Chrome/spa-libcamera CPU-debayer on session
# CPUs starves mutter SCHED_DEADLINE. SoftISP stays in
# dagu-camera-loopback-watch (root, CPU 0-3). Venus is not msm_vfe*.
SUBSYSTEM=="video4linux", ATTR{name}=="msm_vfe*", GROUP="root", MODE="0600", TAG-="uaccess"
