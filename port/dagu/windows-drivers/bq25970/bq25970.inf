[Version]
Signature   = "$WINDOWS NT$"
Class       = Battery
ClassGuid   = {72631e54-78a4-11d0-bcf7-00aa00b7b32a}
Provider    = %Mfg%
DriverVer   = 09/19/2026,1.0.0.0
CatalogFile = bq25970.cat
PnpLockdown = 1

[Manufacturer]
%Mfg% = Models, NTarm64

[Models.NTarm64]
%Desc% = Bq_Inst, ACPI\BQ270970

[Bq_Inst.NT]
CopyFiles = Bq_Copy

[Bq_Inst.NT.Services]
AddService = dagu_bq25970, 0x00000002, Bq_Service

[Bq_Service]
DisplayName    = %Desc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\bq25970.sys

[Bq_Copy]
bq25970.sys

[DestinationDirs]
Bq_Copy = 13

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
bq25970.sys = 1

[Strings]
Mfg  = "dagu"
Desc = "dagu BQ25970 charge pump"
Disk = "dagu BQ25970"
