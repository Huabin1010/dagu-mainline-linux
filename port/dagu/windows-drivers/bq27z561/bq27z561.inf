[Version]
Signature   = "$WINDOWS NT$"
Class       = Battery
ClassGuid   = {72631e54-78a4-11d0-bcf7-00aa00b7b32a}
Provider    = %Mfg%
DriverVer   = 09/19/2026,1.0.0.0
CatalogFile = bq27z561.cat
PnpLockdown = 1

[Manufacturer]
%Mfg% = Models, NTarm64

[Models.NTarm64]
%Desc% = Fg_Inst, ACPI\BQ270561

[Fg_Inst.NT]
CopyFiles = Fg_Copy

[Fg_Inst.NT.Services]
AddService = dagu_bq27z561, 0x00000002, Fg_Service

[Fg_Service]
DisplayName    = %Desc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\bq27z561.sys

[Fg_Copy]
bq27z561.sys

[DestinationDirs]
Fg_Copy = 13

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
bq27z561.sys = 1

[Strings]
Mfg  = "dagu"
Desc = "dagu BQ27Z561 fuel gauge"
Disk = "dagu BQ27Z561"
