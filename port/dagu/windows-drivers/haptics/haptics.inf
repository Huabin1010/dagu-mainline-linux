[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Mfg%
DriverVer   = 09/19/2026,1.0.0.0
CatalogFile = haptics.cat
PnpLockdown = 1

[Manufacturer]
%Mfg% = Models, NTarm64

[Models.NTarm64]
%Desc% = Vib_Inst, ACPI\QCOM24C4

[Vib_Inst.NT]
CopyFiles = Vib_Copy

[Vib_Inst.NT.Services]
AddService = dagu_haptics, 0x00000002, Vib_Service

[Vib_Service]
DisplayName    = %Desc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\haptics.sys

[Vib_Copy]
haptics.sys

[DestinationDirs]
Vib_Copy = 13

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
haptics.sys = 1

[Strings]
Mfg  = "dagu"
Desc = "dagu PM8150B LRA"
Disk = "dagu haptics"
