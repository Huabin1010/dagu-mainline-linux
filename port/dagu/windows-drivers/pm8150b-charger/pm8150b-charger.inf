[Version]
Signature   = "$WINDOWS NT$"
Class       = Battery
ClassGuid   = {72631e54-78a4-11d0-bcf7-00aa00b7b32a}
Provider    = %Mfg%
DriverVer   = 09/19/2026,1.0.0.0
CatalogFile = pm8150b-charger.cat
PnpLockdown = 1

[Manufacturer]
%Mfg% = Models, NTarm64

[Models.NTarm64]
%Desc% = Smb_Inst, ACPI\QCOM24B0

[Smb_Inst.NT]
CopyFiles = Smb_Copy

[Smb_Inst.NT.Services]
AddService = dagu_smb5, 0x00000002, Smb_Service

[Smb_Service]
DisplayName    = %Desc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\pm8150b-charger.sys

[Smb_Copy]
pm8150b-charger.sys

[DestinationDirs]
Smb_Copy = 13

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
pm8150b-charger.sys = 1

[Strings]
Mfg  = "dagu"
Desc = "dagu PM8150B SMB5"
Disk = "dagu SMB5"
