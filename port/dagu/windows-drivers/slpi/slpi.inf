[Version]
Signature   = "$WINDOWS NT$"
Class       = Sensor
ClassGuid   = {5175d334-c371-4806-b3ba-71fd53c9258d}
Provider    = %Mfg%
DriverVer   = 09/19/2026,1.0.0.0
CatalogFile = slpi.cat
PnpLockdown = 1

[Manufacturer]
%Mfg% = Models, NTarm64

[Models.NTarm64]
%Desc% = Slpi_Inst, ACPI\QCOM24C0

[Slpi_Inst.NT]
; Bind only. IMU / ALS stay on SLPI buses 3/4 (lsm6dso, tcs3701).
; Do not invent AP I2C. Do not ship Linux hexagonrpcd.

[Slpi_Inst.NT.Services]
AddService = , 0x00000002

[Strings]
Mfg  = "dagu"
Desc = "dagu SM8250 SLPI (SSC client from WOA-Drivers)"
Disk = "dagu SLPI"
