[Wcd_Inst.NT]
; WCD9385 mics: AMIC5 / ADC4 INP5. Reset GPIO32. SoundWire on LPASS.
; PCM stays on ADSP QCOM24A8. No 3.5mm jack. Do not use inbox HDA.

[Wcd_Inst.NT.Services]
AddService = , 0x00000002

[Strings]
Mfg  = "dagu"
Desc = "dagu WCD9385 (ADSP + SoundWire)"
Disk = "dagu WCD9385"
